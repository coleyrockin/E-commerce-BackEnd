DB_NAME=ecommerce_db
DB_USER=ecommerce_app
DB_PASSWORD=change_me
WRITE_API_KEY=change_me

# Optional: set PORT if you want to override the default 3001
# PORT=3001

# Optional: a single connection URL overrides the three DB_* vars above.
# Used by hosts like Heroku/Render that provide a managed MySQL URL.
# JAWSDB_URL=mysql://user:pass@host:3306/dbname
